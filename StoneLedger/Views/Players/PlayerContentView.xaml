<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:StoneLedger.Resources.Converters"
    x:Class="StoneLedger.Views.Players.PlayerContentView"
    x:Name="Root">

    <ContentView.Resources>
        <conv:NullToDefaultImageConverter x:Key="NullToDefaultImageConverter" />
    </ContentView.Resources>

    <Grid x:Name="RootLayout"
          RowDefinitions="Auto, Auto, Auto, Auto, Auto, *"
          Padding="12"
          RowSpacing="2"
          BackgroundColor="{StaticResource SecondaryColor}">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenPlayerCommand}" />
        </Grid.GestureRecognizers>

        <!-- Portrait -->
        <Border Grid.Row="0"
                HeightRequest="200"
                StrokeThickness="0"
                BackgroundColor="{StaticResource BackgroundColor}"
                StrokeShape="RoundRectangle 16"
                Padding="0"
                HorizontalOptions="Fill">
            <Image Aspect="AspectFill"
                   Source="{Binding PortraitUrl, Converter={StaticResource NullToDefaultImageConverter}}" />
        </Border>

        <!-- Name -->
        <Label Grid.Row="1"
               Text="{Binding Name}"
               Style="{StaticResource ListItemTitleStyle}"
               HorizontalTextAlignment="Center"
               LineBreakMode="TailTruncation" />

        <!-- Stone indicator -->
        <Grid Grid.Row="2" HorizontalOptions="Center">
            <Image x:Name="BlackStone"
                   Source="blackplayer.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   IsVisible="False">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ReloadPortraitCommand}" />
                </Image.GestureRecognizers>
                <Image.Triggers>
                    <DataTrigger TargetType="Image"
                          Binding="{Binding Source={x:Reference Root}, Path=SideIndicator}"
                         Value="1">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Image.Triggers>
            </Image>

            <Image x:Name="WhiteStone"
                   Source="whiteplayer.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   IsVisible="False">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ReloadPortraitCommand}" />
                </Image.GestureRecognizers>
                <Image.Triggers>
                    <DataTrigger TargetType="Image"
                          Binding="{Binding Source={x:Reference Root}, Path=SideIndicator}"
                         Value="2">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Image.Triggers>
            </Image>
        </Grid>

        <!-- Rank -->
        <Label Grid.Row="3"
               Text="{Binding Rank}"
               FontSize="14"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource SecondaryColor}" />

        <!-- Birth Year -->
        <Label Grid.Row="4"
               Text="{Binding BirthYear, StringFormat='Born {0}'}"
               FontSize="14"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource SecondaryColor}" />

        <!-- Team logo, anchored to bottom of card -->
        <Border Grid.Row="5"
                HeightRequest="80"
                StrokeThickness="0"
                BackgroundColor="{StaticResource BackgroundColor}"
                StrokeShape="RoundRectangle 14"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="End"
                WidthRequest="80">
            <Image Aspect="AspectFill"
                   Source="{Binding TeamImageUrl, Converter={StaticResource NullToDefaultImageConverter}}" />
        </Border>

    </Grid>
</ContentView>
